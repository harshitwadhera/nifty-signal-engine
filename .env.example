KITE_API_KEY=
KITE_API_SECRET=
KITE_REDIRECT_URL=http://127.0.0.1:8000/kite/callback
# Optional SQLite path; defaults to data/market.sqlite3 in the project.
# MARKET_DB_PATH=data/market.sqlite3
# Options analytics defaults (annual decimal risk-free rate; thresholds in percent).
# OPTIONS_RISK_FREE_RATE=0.06
# OPTIONS_REFRESH_SECONDS=20
# OPTIONS_STALE_SECONDS=60
# OPTIONS_PRICE_CHANGE_PERCENT=0.5
# OPTIONS_OI_CHANGE_PERCENT=1
# OPTIONS_LIQUID_SPREAD_PERCENT=1
# OPTIONS_MODERATE_SPREAD_PERCENT=3
# OPTIONS_LIQUID_MIN_OI=1000
# OPTIONS_LIQUID_MIN_VOLUME=100
# OPTIONS_MODERATE_MIN_OI=100
# OPTIONS_MODERATE_MIN_VOLUME=10

# Optional dated membership/weights JSON. Omit to load official current CSV lists.
# BREADTH_CONSTITUENTS_FILE=data/constituents.json
