KITE_API_KEY=
KITE_API_SECRET=
KITE_REDIRECT_URL=http://127.0.0.1:8000/kite/callback
# Exact hostnames only; no scheme, port or wildcard. Add your production domain.
APP_ALLOWED_HOSTS=127.0.0.1,localhost,testserver
# Relative paths resolve from the project root. Compose overrides this to /app/data/market.sqlite3.
MARKET_DB_PATH=data/market.sqlite3
# Compose: trust only the HTTPS proxy's source IP as seen by the container.
# For a host proxy on Linux Docker bridge, use its inspected bridge gateway IP.
# Never use * or a public/client subnet.
PROXY_TRUSTED_IPS=127.0.0.1
# Options analytics defaults (annual decimal risk-free rate; thresholds in percent).
# OPTIONS_RISK_FREE_RATE=0.06
# OPTIONS_REFRESH_SECONDS=20
# OPTIONS_STALE_SECONDS=60
# OPTIONS_PRICE_CHANGE_PERCENT=0.5
# OPTIONS_OI_CHANGE_PERCENT=1
# OPTIONS_LIQUID_SPREAD_PERCENT=1
# OPTIONS_MODERATE_SPREAD_PERCENT=3
# OPTIONS_LIQUID_MIN_OI=1000
# OPTIONS_LIQUID_MIN_VOLUME=100
# OPTIONS_MODERATE_MIN_OI=100
# OPTIONS_MODERATE_MIN_VOLUME=10

# Optional dated membership/weights JSON. Omit to load official current CSV lists.
# BREADTH_CONSTITUENTS_FILE=data/constituents.json

# Structural signal plans only. These settings never enable order placement.
# SIGNAL_MIN_T1_RR=1.5
# SIGNAL_CANDIDATE_LIFETIME_SECONDS=900
# SIGNAL_NEW_ENTRY_CUTOFF=15:00
# SIGNAL_OPTION_QUOTE_MAX_AGE_SECONDS=30
# SIGNAL_OPTION_MAX_SPREAD_PERCENT=1
# SIGNAL_OPTION_MIN_OI=1000
# SIGNAL_OPTION_MIN_VOLUME=100
